{
  "name": "research-local-xiaomi",
  "version": "0.1.0",
  "description": "Local research orchestration CLI powered by Xiaomi MiMo Web Search.",
  "type": "module",
  "bin": {
    "research-xm": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "research-xm": "tsx src/cli.ts"
  },
  "keywords": [
    "research",
    "xiaomi",
    "mimo",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
